# ============================================
# ClassPulse 환경변수 (.env.local로 복사하여 사용)
# 절대 GitHub에 올리지 마세요!
# ============================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# OpenAI
OPENAI_API_KEY=sk-your_openai_key_here

# Jina Reader API (무료 — 분당 200회, 1천만 토큰)
JINA_API_KEY=jina_your_key_here

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 데모 계정 (시드 데이터와 일치해야 함)
NEXT_PUBLIC_DEMO_STUDENT_EMAIL=student@classpulse.demo
NEXT_PUBLIC_DEMO_ADMIN_EMAIL=admin@classpulse.demo
NEXT_PUBLIC_DEMO_PASSWORD=classpulse2024!
